# Local development env for `npm run ingest` / `npm run eval`.
# Copy to `.env` (gitignored) and fill in your key. CI does NOT use this file —
# GitHub Actions injects GEMINI_API_KEY from a repo secret (see .github/workflows/ingest.yml).

# Required: Gemini API key. Never commit the real value.
GEMINI_API_KEY=

# Optional: override the model. Defaults to config/sources.json "model" if unset.
# GEMINI_MODEL=gemini-flash-lite-latest
